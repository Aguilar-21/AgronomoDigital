# .env.example
#
# Copia este archivo a ".env" y rellena con TUS datos reales.
# El archivo .env NO se sube a GitHub (esta en el .gitignore).
#
# Todas estas variables se validan al arrancar (ver src/config/env.ts). Si
# falta una obligatoria o una tiene formato invalido, el servidor NO arranca y
# dice cual es el problema. Es mejor eso que arrancar y fallar en la primera
# consulta, con un error que no menciona la variable que falta.

# ------------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------------
DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contrasena_mysql
DB_DATABASE=agronomodigital

# ------------------------------------------------------------------
# Autenticacion
# ------------------------------------------------------------------
#
# Clave con la que se firman los tokens JWT. Minimo 16 caracteres, y el servidor
# se niega a arrancar si es mas corta.
#
# Esta clave es lo UNICO que impide que alguien se haga su propio token. Si se
# filtra, cualquiera puede entrar como cualquier usuario. Para generarla:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
JWT_SECRETO=escribe_una_clave_secreta_larga_y_aleatoria

# ------------------------------------------------------------------
# Servidor
# ------------------------------------------------------------------
#
# development: mensajes de error completos en la respuesta
# production:  mensaje generico, el detalle va al log
# test:        se usa para las pruebas automatizadas
#
NODE_ENV=development

PUERTO=3002

# ------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------
#
# Uno de: trace, debug, info, warn, error, fatal, silent
#
# Con "info" se registra cada peticion. Con "debug" tambien, y el archivo se
# llena en minutos. Para trabajar en local conviene "debug".
#
LOG_LEVEL=debug

# ------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------
#
# Origenes permitidos, separados por coma. OJO: el valor NO lleva el protocolo,
# solo el dominio y el puerto. Con "https://miapp.com,https://www.miapp.com"
# acepta los dos; con "https://miapp.com:5173" acepta ese puerto exacto.
#
# Dejarlo VACIO permite cualquier origen. Es lo que hace falta para trabajar en
# local con el frontend abierto como archivo, pero es un agujero si el backend es
# publico: cualquiera podria llamar a la API desde su propia pagina. Antes de
# publicar, pone aqui el dominio real.
#
CORS_ORIGENES=
